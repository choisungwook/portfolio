{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-awsviewer",
  "version": "../package.json",
  "identifier": "io.akbun.awsviewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "akbun-awsviewer",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 600,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-awsviewer-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERkExMjY5MzZFNEREMzQKUldRMDNlUTJhUkw2SGFJNDJIcG1LVEZoZEFvYW5kVHpFSk5KRlpZUVJ0Ny9MWHZkaThyWFpzamUK"
    }
  }
}
