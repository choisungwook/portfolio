{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-taskq",
  "version": "../../package.json",
  "identifier": "io.akbun.taskq",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "externalBin": [
      "binaries/taskq"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
