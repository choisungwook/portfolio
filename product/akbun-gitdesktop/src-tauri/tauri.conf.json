{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-gitdesktop",
  "version": "../package.json",
  "identifier": "io.akbun.gitdesktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "akbun-gitdesktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#f6f7f9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-gitdesktop-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMTU4MzMwMzQ1N0JEQkMKUldTOHZWYzBNSU1Wbk5wWWs4MER5TnMyb3lnQ21yRElibTZad3hnM2FqdTg5NWlJUlRJenVlcnUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
