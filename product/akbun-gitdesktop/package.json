{
  "name": "akbun-gitdesktop",
  "productName": "akbun-gitdesktop",
  "version": "0.6.1",
  "description": "Git graph desktop viewer for local repositories and worktrees",
  "author": "akbun",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/renderer-utils.test.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p gitdesktop-core",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
