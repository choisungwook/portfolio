{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akbun-reader",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akbun-reader",
      "database_id": "replace-after-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ]
}
