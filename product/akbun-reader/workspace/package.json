{
  "name": "akbun-reader",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler types && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply akbun-reader --local",
    "migrate:remote": "wrangler d1 migrations apply akbun-reader --remote",
    "test": "node --test test/*.test.js",
    "benchmark:extraction": "node scripts/benchmark-extraction.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "zod": "^4.5.4"
  }
}
