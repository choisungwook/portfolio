{
  "name": "akbun-ai-useage",
  "version": "0.1.0",
  "description": "Menu bar app that shows Claude Code, Codex and Kiro usage: subscription limits, tokens and organization cost",
  "author": "akbun",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.akbun.aiuseage",
    "productName": "akbun-ai-useage",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
