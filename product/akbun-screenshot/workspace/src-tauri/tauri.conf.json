{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-screenshot",
  "version": "../package.json",
  "identifier": "io.akbun.screenshot",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-screenshot-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGM0Y2Q0MzNTVBMzgxQjAKUldTd2dhTlZ3MncvYndLZDdLVytJTy9MNHQrbS9sVW1TU1NpaTJNT2Q4V01IYUl2ZENPb0tGdjMK"
    }
  }
}
