{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-makepodcast",
  "version": "../package.json",
  "identifier": "io.akbun.makepodcast",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "akbun-makepodcast",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#f1f3f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-makepodcast-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MEZEM0FGQUJGMUEyNEYKUldSUG92R3JyOU1QbUtDdU41cllTQkVLM0ZRd2lPY01aSllhZGVqN1VqeUFPWDduYkdqVG5yMWUK"
    }
  }
}
