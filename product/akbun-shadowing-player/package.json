{
  "name": "akbun-shadowing-player",
  "productName": "akbun-shadowing-player",
  "version": "0.7.0",
  "description": "언어 공부(쉐도잉)용 구간 반복 오디오 플레이어",
  "main": "dist/main/main.js",
  "author": "akbun",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.akbun.shadowing-player",
    "productName": "akbun-shadowing-player",
    "files": [
      "dist/**/*",
      "static/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    }
  }
}
