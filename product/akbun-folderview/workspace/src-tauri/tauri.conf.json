{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-folderview",
  "version": "../package.json",
  "identifier": "io.akbun.folderview",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "akbun-folderview",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#1b1b1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQTYyQTIxQUM5NTkzMEQKUldRTms1V3NJU3FtbzFzWlNSdlJFV2NHK05DMzAvVnRka05Td244QldPb0FRM2psZDJHRDVMY2MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
