{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-makephoto",
  "version": "../package.json",
  "identifier": "io.akbun.makephoto",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "akbun-makephoto",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#f2f3f5",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-makephoto-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RkMzMTM1NzUxRDRGQzgKUldUSVR4MTFOVEg4WlZlN2hld2oxUkN0NDIvSTBQRENVY0Q2bk5uaEYzSVFKQzZpY3BvYVUrMmMK"
    }
  }
}
