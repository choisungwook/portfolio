{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbun.io/pdf/contracts/commands.schema.json",
  "title": "CommandContract",
  "type": "object",
  "required": ["commands"],
  "properties": {
    "commands": {
      "const": [
        {
          "name": "get_document_state",
          "request": null,
          "response": "DocumentState"
        },
        {
          "name": "open_document",
          "request": { "path": "string" },
          "response": "OpenDocumentPayload"
        },
        {
          "name": "complete_document_open",
          "request": { "documentId": "string", "pageCount": "integer", "outline": "OutlineItem[]" },
          "response": "DocumentState"
        },
        {
          "name": "fail_document_open",
          "request": { "documentId": "string", "message": "string" },
          "response": "DocumentState"
        },
        {
          "name": "save_document",
          "request": { "documentId": "string" },
          "response": "SaveResult"
        },
        {
          "name": "save_document_as",
          "request": { "documentId": "string", "path": "string" },
          "response": "SaveResult"
        },
        {
          "name": "reorder_page",
          "request": { "documentId": "string", "fromPage": "integer", "toPage": "integer" },
          "response": "DocumentState"
        },
        {
          "name": "delete_page",
          "request": { "documentId": "string", "page": "integer" },
          "response": "DocumentState"
        },
        {
          "name": "rotate_page",
          "request": { "documentId": "string", "page": "integer", "degrees": "integer" },
          "response": "DocumentState"
        },
        {
          "name": "upsert_annotation",
          "request": { "documentId": "string", "annotation": "AnnotationDraft" },
          "response": "DocumentState"
        },
        {
          "name": "delete_annotation",
          "request": { "documentId": "string", "annotationId": "string" },
          "response": "DocumentState"
        },
        {
          "name": "add_merge_files",
          "request": { "paths": "string[]" },
          "response": "MergeFile[]"
        },
        {
          "name": "save_merged_document",
          "request": { "fileIds": "string[]", "path": "string" },
          "response": "MergeReport"
        },
        {
          "name": "clear_merge_files",
          "request": null,
          "response": null
        },
        {
          "name": "close_document",
          "request": null,
          "response": "DocumentState"
        }
      ]
    }
  },
  "additionalProperties": false
}
