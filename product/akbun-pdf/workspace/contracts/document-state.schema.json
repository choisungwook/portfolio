{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbun.io/pdf/contracts/document-state.schema.json",
  "title": "DocumentState",
  "type": "object",
  "required": ["phase", "documentId", "title", "currentPage", "pageCount", "zoom", "dirty", "thumbnails", "outline", "annotations", "errorMessage"],
  "properties": {
    "phase": { "enum": ["empty", "loading", "ready", "error"] },
    "documentId": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "currentPage": { "type": "integer", "minimum": 0 },
    "pageCount": { "type": "integer", "minimum": 0 },
    "zoom": { "type": "number", "minimum": 0.25, "maximum": 4 },
    "dirty": { "type": "boolean" },
    "thumbnails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "sourcePage", "rotation", "label"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "sourcePage": { "type": "integer", "minimum": 1 },
          "rotation": { "enum": [0, 90, 180, 270] },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "kind", "rect", "color", "contents"],
        "properties": {
          "id": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["highlight", "note"] },
          "rect": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" }
            },
            "additionalProperties": false
          },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "contents": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "page", "top", "depth"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "top": { "type": ["number", "null"] },
          "depth": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "errorMessage": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
