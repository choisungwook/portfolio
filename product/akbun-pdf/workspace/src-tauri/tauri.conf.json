{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akbun-pdf",
  "version": "../package.json",
  "identifier": "io.akbun.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "akbun-pdf",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#f5f4f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/choisungwook/portfolio/releases/download/akbun-pdf-updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNDY1MEJFQzQ0MzBGMDgKUldRSUQwUEV2bEJHV3dQNVU0MHJSd3ZOZGI4UXJvZ1Jsd3RPbGtzY2Jsbkc2SUs1N1NRNTFSMnEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
