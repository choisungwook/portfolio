{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/guardrail.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/require-commit-hooks.sh",
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/prepush-scan.sh",
            "onFailure": "block",
            "statusMessage": "Checking what this command publishes",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/require-commit-hooks.sh",
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/prepush-scan.sh",
            "onFailure": "block",
            "statusMessage": "Checking what this command publishes",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/markdownlint.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/terraformlint.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/repochecks.sh"
          }
        ]
      }
    ]
  }
}
