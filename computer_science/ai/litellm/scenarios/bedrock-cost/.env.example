# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-salt-change-me
POSTGRES_PASSWORD=change-me

# bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream 권한이 있는 IAM 사용자의 키
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# global inference profile을 호출할 source region. 청구와 CloudWatch 지표가 이 리전에 남는다.
AWS_REGION_NAME=us-east-1
