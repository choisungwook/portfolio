{
  "uid": "cache-no-call",
  "title": "3. 같은 요청은 Bedrock을 부르지 않는다",
  "description": "LiteLLM 응답 캐시가 hit일 때 Bedrock 호출이 생기지 않는 것을 시간축으로 보여 준다. 시나리오 2를 돌린 뒤 본다.",
  "tags": [
    "litellm",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "캐시 hit (누적)",
      "description": "Redis가 응답한 요청 수. Bedrock 호출이 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(litellm_cache_hits_metric_total)",
          "legendFormat": "캐시 hit (누적)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5286E0"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Bedrock 호출 (10분 구간)",
      "description": "같은 구간에 Bedrock이 처리한 호출.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aws_bedrock_invocations_sum)",
          "legendFormat": "Bedrock 호출 (10분 구간)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#B8651F"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "캐시가 막아 준 비율",
      "description": "요청 중 Bedrock에 닿지 않은 비율.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(litellm_cache_hits_metric_total) / sum(litellm_proxy_total_requests_metric_total)",
          "legendFormat": "캐시가 막아 준 비율",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#7f8fa4"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "캐시 hit이 다시 적은 token",
      "description": "hit 응답의 usage를 그대로 다시 적은 token. Bedrock 장부에는 없는 숫자다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(litellm_cached_tokens_metric_total)",
          "legendFormat": "캐시 hit이 다시 적은 token",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#7f8fa4"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "같은 요청 10번: hit은 올라가고 호출은 그대로다",
      "description": "시나리오 2를 돌리면 hit 선만 9만큼 오르고 Bedrock 선은 1에서 멈춘다. 같은 요청이 Bedrock을 부르지 않는다는 뜻이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(litellm_cache_hits_metric_total[2m]))",
          "legendFormat": "Redis hit (LiteLLM에서 끝남)",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aws_bedrock_invocations_sum)",
          "legendFormat": "Bedrock 호출",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Redis hit (LiteLLM에서 끝남)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5286E0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bedrock 호출"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B8651F"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "hit이 만들어 내는 token",
      "description": "hit은 Bedrock을 부르지 않고도 LiteLLM 쪽 token을 올린다. 금액은 0으로 적히므로 spend는 어긋나지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(litellm_output_tokens_metric_total[2m]))",
          "legendFormat": "LiteLLM output (재기록 포함)",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aws_bedrock_output_token_count_sum)",
          "legendFormat": "Bedrock output (실제 생성)",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LiteLLM output (재기록 포함)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5286E0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bedrock output (실제 생성)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B8651F"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "editable": true
}
