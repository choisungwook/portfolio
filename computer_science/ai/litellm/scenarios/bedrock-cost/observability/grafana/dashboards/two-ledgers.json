          },
          "expr": "clamp_min(sum(litellm_provider_cache_read_input_tokens_metric_total) - sum(litellm_provider_cache_read_input_tokens_metric_total offset $__interval), 0)",
          "legendFormat": "캐시 읽기 · LiteLLM (구간 증가분)",
