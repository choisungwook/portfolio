          },
          "expr": "clamp_min(sum(litellm_provider_cache_creation_input_tokens_metric_total) - sum(litellm_provider_cache_creation_input_tokens_metric_total offset $__interval), 0)",
          "legendFormat": "캐시 쓰기 · LiteLLM (구간 증가분)",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
