{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[1m])) by (le))",
          "legendFormat": "TTFT p95",
          "refId": "A"
        }
      ],
      "title": "vLLM TTFT p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:request_time_per_output_token_seconds_bucket[1m])) by (le))",
          "legendFormat": "TPOT p95",
          "refId": "A"
        }
      ],
      "title": "vLLM TPOT p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "E2E p95",
          "refId": "A"
        }
      ],
      "title": "vLLM E2E p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(vllm:request_success_total[1m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "title": "vLLM RPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "Output TPS",
          "refId": "A"
        }
      ],
      "title": "vLLM Output TPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ],
      "title": "vLLM Scheduler",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "id": 7,
      "targets": [
        {
          "expr": "max(vllm:kv_cache_usage_perc)",
          "legendFormat": "KV cache",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vllm:prefix_cache_hits_total[1m])) / clamp_min(sum(rate(vllm:prefix_cache_queries_total[1m])), 1)",
          "legendFormat": "prefix hit rate",
          "refId": "B"
        }
      ],
      "title": "vLLM Cache",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:request_queue_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "queue p95",
          "refId": "A"
        }
      ],
      "title": "vLLM Queue p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:request_prefill_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "prefill p95",
          "refId": "A"
        }
      ],
      "title": "vLLM Prefill p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "id": 10,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:request_decode_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "decode p95",
          "refId": "A"
        }
      ],
      "title": "vLLM Decode p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 11,
      "targets": [
        {
          "expr": "max(max_over_time(DCGM_FI_DEV_FB_USED[5s]))",
          "legendFormat": "VRAM used",
          "refId": "A"
        }
      ],
      "description": "DCGM reports MiB. The panel keeps each sample visible for 5 seconds so short model-load peaks are less likely to disappear at Grafana query resolution.",
      "title": "GPU VRAM",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 12,
      "targets": [
        {
          "expr": "max(max_over_time(DCGM_FI_DEV_GPU_UTIL[5s]))",
          "legendFormat": "GPU utilization",
          "refId": "A"
        }
      ],
      "description": "Rolling 5-second maximum of DCGM samples. It validates that the GPU became busy; it is not expected to equal an nvidia-smi sample taken at a different instant.",
      "title": "GPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 13,
      "targets": [
        {
          "expr": "max(DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "power",
          "refId": "A"
        }
      ],
      "title": "GPU Power",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Both are time-busy ratios, not bandwidth ratios. On this GeForce card they were measured moving together even in a compute-bound prefill run (100% vs 96%), so do NOT use the pair to classify compute-bound versus bandwidth-bound. What this panel is good for is the case where both stay low: the GPU is idle and the problem is client concurrency or the queue. For bottleneck classification compare measured token rate against the bandwidth ceiling - see docs/handson/04-roofline-bottleneck.md.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 14,
      "title": "GPU busy vs Memory busy",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "SM busy (compute)",
          "refId": "A"
        },
        {
          "expr": "max(DCGM_FI_DEV_MEM_COPY_UTIL)",
          "legendFormat": "memory busy (bandwidth)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The KV pool is reserved once at startup. When the pool fills, the scheduler stops admitting and requests move from running to waiting. That crossing is the real max batch size for this workload.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 15,
      "title": "KV pool occupancy vs admitted requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(vllm:kv_cache_usage_perc or vllm:gpu_cache_usage_perc) * 100",
          "legendFormat": "KV pool used %",
          "refId": "A"
        },
        {
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting",
          "refId": "C"
        }
      ]
    }
  ],
