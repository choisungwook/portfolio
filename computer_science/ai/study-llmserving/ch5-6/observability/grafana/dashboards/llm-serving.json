      "title": "GPU VRAM",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "id": 12,
      "targets": [
        {"expr": "max(DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "GPU utilization", "refId": "A"}
