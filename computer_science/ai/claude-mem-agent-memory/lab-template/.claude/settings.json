{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__MINIMEM__/.venv/bin/minimem-hook\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__MINIMEM__/.venv/bin/minimem-hook\" prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__MINIMEM__/.venv/bin/minimem-hook\" tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__MINIMEM__/.venv/bin/minimem-hook\" stop"
          }
        ]
      }
    ]
  }
}
