{
  "uid": "litellm-cost",
  "title": "LiteLLM 비용",
  "description": "LiteLLM 가격표로 계산한 계정·team·model·key별 spend",
  "tags": [
    "litellm"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "저장소",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "account",
        "label": "계정",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"litellm\"}, account)",
          "refId": "account"
        },
        "definition": "label_values(up{job=\"litellm\"}, account)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**금액의 뜻** · LiteLLM이 자기 가격표로 계산한 추정 금액(USD)이다. AWS 청구서와 같지 않다. 응답 캐시, prompt caching, 끊긴 스트림에서 차이가 난다. 오른쪽 위 시간 범위가 합계 구간이다."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "선택 구간 총 spend",
      "description": "선택한 시간 범위 동안 쌓인 spend 합계.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account) (increase(litellm_spend_metric_total{account=~\"$account\"}[$__range]))",
          "legendFormat": "{{account}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "stat",
      "title": "선택 구간 총 token",
      "description": "input + output token 합계.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account) (increase(litellm_total_tokens_metric_total{account=~\"$account\"}[$__range]))",
          "legendFormat": "{{account}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "stat",
      "title": "시간당 spend",
      "description": "최근 1시간 spend. 급증을 가장 먼저 알아채는 숫자다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account) (increase(litellm_spend_metric_total{account=~\"$account\"}[1h]))",
          "legendFormat": "{{account}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "계정별 spend 추이 (시간당)",
      "description": "1시간 창으로 본 spend 추이.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account) (increase(litellm_spend_metric_total{account=~\"$account\"}[1h]))",
          "legendFormat": "{{account}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "team별 spend 추이 (시간당)",
      "description": "어느 team이 비용을 끌어올렸는지 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (account, team_alias) (increase(litellm_spend_metric_total{account=~\"$account\"}[1h]))",
          "legendFormat": "{{account}} {{team_alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "table",
      "title": "team·model별 spend (선택 구간)",
      "description": "선택 구간 합계를 team과 model로 나눈 표.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (account, team_alias, model) (increase(litellm_spend_metric_total{account=~\"$account\"}[$__range])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 7
    },
    {
      "type": "table",
      "title": "key별 spend 상위 10 (선택 구간)",
      "description": "virtual key 이름(api_key_alias) 기준 상위 10개.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (account, team_alias, api_key_alias) (increase(litellm_spend_metric_total{account=~\"$account\"}[$__range])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 8
    }
  ]
}
