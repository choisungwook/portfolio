{
  "uid": "amp-vs-cloudwatch",
  "title": "AMP와 CloudWatch 같은 질문 비교",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "AMP · model별 요청 수/초",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (model) (rate(demo_requests_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "CloudWatch · model별 요청 수/초",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "cloudwatch"
          },
          "expr": "sum by (model) (rate(demo_requests_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "AMP · replica별 요청 수/초",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (instance) (rate(demo_requests_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "CloudWatch · replica별 요청 수/초",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "cloudwatch"
          },
          "expr": "sum by (\"@resource.service.instance.id\") (rate(demo_requests_total[5m]))",
          "legendFormat": "{{\"@resource.service.instance.id\"}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "AMP · model별 p95 응답 시간",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(demo_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "CloudWatch · model별 p95 응답 시간",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "cloudwatch"
          },
          "expr": "histogram_quantile(0.95, sum by (model) (rate(demo_request_duration_seconds[5m])))",
          "legendFormat": "{{model}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "AMP · 실패율",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(rate(demo_requests_total{status=\"500\"}[5m])) / sum(rate(demo_requests_total[5m]))",
          "legendFormat": "실패율"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "CloudWatch · 실패율",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "cloudwatch"
          },
          "expr": "sum(rate(demo_requests_total{status=\"500\"}[5m])) / sum(rate(demo_requests_total[5m]))",
          "legendFormat": "실패율"
        }
      ],
      "id": 8
    }
  ]
}