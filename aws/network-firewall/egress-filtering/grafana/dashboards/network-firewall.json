    {
      "id": 4,
      "type": "table",
      "title": "Blocked domains (alert log)",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroupNames": [
            "/aws/network-firewall/nfw-lab/alert"
          ],
          "logGroups": [],
          "expression": "filter event.alert.action = \"blocked\"\n| fields coalesce(event.tls.sni, event.http.hostname) as domain\n| stats count(*) as hits by domain, event.src_ip\n| sort hits desc\n| limit 20",
          "statsGroups": []
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent alert events",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroupNames": [
            "/aws/network-firewall/nfw-lab/alert"
          ],
          "logGroups": [],
          "expression": "fields @timestamp, event.alert.action, event.src_ip, coalesce(event.tls.sni, event.http.hostname) as domain, event.alert.signature\n| sort @timestamp desc\n| limit 50",
          "statsGroups": []
        }
      ]
    }
